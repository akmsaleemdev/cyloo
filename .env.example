# =====================================================================
# GCC-CRM environment reference — copy per service; NEVER commit values.
# Placement column: [web]=browser-safe, [api]=server, [worker]=queue
# process, [ci]=CI/CD secrets only.
# =====================================================================

# --- API (Vercel functions / ECS) ---
PORT=3001                                        # [api]
NODE_ENV=development                             # [api]
DEV_AUTH_SECRET=                                 # [api] HMAC for dev tokens (prod uses Supabase JWT; rotate on leak)
APP_ENCRYPTION_KEY=                              # [api] envelope key for provider_credentials at rest

# --- Web (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:3001        # [web]
NEXT_PUBLIC_SENTRY_DSN=                          # [web]

# --- Supabase (cutover) ---
SUPABASE_URL=                                    # [web]+[api]
SUPABASE_ANON_KEY=                               # [web] (RLS is the boundary)
SUPABASE_SERVICE_ROLE_KEY=                       # [api/worker] ONLY — bypasses RLS
DATABASE_URL=                                    # [api/worker] pooled 6543, NOBYPASSRLS role
MIGRATION_DATABASE_URL=                          # [ci] direct 5432 — never serves traffic

# --- Redis / queues ---
REDIS_URL=                                       # [worker]

# --- AI providers (server only) ---
OPENAI_API_KEY=                                  # [api/ai]
OPENAI_MODEL=gpt-4o-mini                         # [api/ai]
ANTHROPIC_API_KEY=                               # [api/ai]
AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=      # [ai] Bedrock region routing
GOOGLE_VERTEX_CREDENTIALS=                       # [ai]

# --- WhatsApp / Meta ---
WA_TOKEN= WA_PHONE_ID= WA_WABA_ID=               # [api]
WA_VERIFY_TOKEN= WA_WEBHOOK_SECRET=              # [api]
IG_TOKEN= IG_ACCOUNT_ID= FB_PAGE_TOKEN=          # [api]

# --- Ads / analytics ---
GOOGLE_ADS_DEVELOPER_TOKEN=                      # [api]
GOOGLE_ADS_CLIENT_ID= GOOGLE_ADS_CLIENT_SECRET= GOOGLE_ADS_REFRESH_TOKEN=  # [api]
META_ADS_TOKEN=                                  # [api]
TIKTOK_CLIENT_KEY= TIKTOK_CLIENT_SECRET=         # [api]
SNAP_CLIENT_ID= SNAP_CLIENT_SECRET=              # [api]
NEXT_PUBLIC_GA4_ID=                              # [web]

# --- Email / SMS / Voice ---
EMAIL_API_KEY= EMAIL_FROM=                       # [api]
SMS_SID= SMS_TOKEN= SMS_FROM=                    # [api]
VOICE_SID= VOICE_TOKEN= VOICE_NUMBER=            # [api]

# --- Calendar sync ---
GOOGLE_CAL_CLIENT_ID= GOOGLE_CAL_CLIENT_SECRET=  # [api]
MS_CAL_CLIENT_ID= MS_CAL_CLIENT_SECRET=          # [api]

# --- Payments ---
STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=        # [api]
GCC_GW_MERCHANT_ID= GCC_GW_API_KEY=              # [api] regional gateway

# --- Observability ---
SENTRY_DSN=                                      # [api/worker]
